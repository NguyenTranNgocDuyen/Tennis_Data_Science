        {
          "name": "season",
          "dtype": "integer",
          "unit": "see table description",
          "nullable": false
        },
        {
          "name": "n_matches",
          "dtype": "integer",
          "unit": "count",
          "nullable": false
        },
        {
          "name": "n_completed",
          "dtype": "integer",
          "unit": "count",
          "nullable": false
        },
        {
          "name": "n_tournaments",
          "dtype": "integer",
          "unit": "count",
          "nullable": false
        },
        {
          "name": "n_duration",
          "dtype": "integer",
          "unit": "count",
          "nullable": false
        },
        {
          "name": "median_minutes",
          "dtype": "number",
          "unit": "minutes",
          "nullable": true
        },
        {
          "name": "n_ranked_completed",
          "dtype": "integer",
          "unit": "count",
          "nullable": false
        },
        {
