# Copy this file to .env, then enter your own key locally.
# Subscribe to the FREE Tennis API - ATP WTA ITF product on RapidAPI first.
# https://rapidapi.com/jjrm365-kIFr3Nx_odV/api/tennis-api-atp-wta-itf
RAPIDAPI_KEY=

# Personal Telegram alerts. Open the bot's private chat and send /start.
# Keep the token local; TELEGRAM_CHAT_ID must be your positive private chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
