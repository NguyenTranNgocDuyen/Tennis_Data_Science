      "x-csv": {
        "dtype": "string",
        "core": true
      }
    },
    "tourney_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Tên giải theo nguồn.",
      "x-csv": {
        "dtype": "string",
        "core": true
      }
    },
    "surface": {
      "type": [
        "string",
        "null"
      ],
